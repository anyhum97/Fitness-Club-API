{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=club;Username=club;Password=club",
    "Redis": "localhost:6380"
  },
  "Jwt": {
    "Issuer": "club-api",
    "Audience": "club-api",
    "Key": "5f2a9c41e7b84d0ba63c8e19d472af5c0916b3ed7c8241a5fe36b90d4c17e28a",
    "LifetimeMinutes": 720
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] trace={TraceId} user={UserId} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/webapi-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] trace={TraceId} user={UserId} {RequestMethod} {RequestPath} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
